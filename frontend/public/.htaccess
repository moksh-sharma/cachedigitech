Options -MultiViews
RewriteEngine On
RewriteBase /

# If Apache would return 404, serve the SPA so React Router can show /404
ErrorDocument 404 /index.html

# SPA fallback: serve index.html for any path that is not a real file/dir
# Unknown URLs (e.g. /mn) load the app, which redirects to /404
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/assets/
RewriteCond %{REQUEST_URI} !\.(css|js|jpe?g|gif|png|svg|ico|webp|avif|woff2?|ttf|eot|otf|json|html|xml|txt|pdf|zip|map|webm|mp4)$ [NC]
RewriteRule ^ index.html [L,QSA]

# Enable compression (smaller transfer = faster load)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Set cache headers for static assets (long cache = faster repeat loads)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>
